# rs2004.quests.engine.trace: step tracing for the quest engine.

from typing import Any, Mapping, Optional

HEARTBEAT_ATTEMPTS: int
HEARTBEAT_MS: int
FAIL_WARN: int

def format_duration(ms: float) -> str: ...
def format_tile(tile: Optional[Any]) -> str: ...
def inv_delta(before: Mapping[str, int], after: Mapping[str, int]) -> str: ...

class StepTracker:
    def open(self, key: str, now: float) -> int: ...
    def attempts(self) -> int: ...
    def elapsed(self, now: float) -> float: ...
    def beat(self, now: float) -> bool: ...
    def reset(self) -> None: ...
