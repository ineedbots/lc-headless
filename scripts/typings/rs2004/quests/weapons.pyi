# rs2004.quests.weapons: the melee weapons and pickaxes a quest arms itself with. See docs/scripting/quests.md.

from typing import Callable, Mapping, Optional

from rs2004.quests.engine.types import QuestSnapshot

class MeleeWeapon:
    id: int
    name: str
    tier: str
    attack: int
    quest: Optional[str]
    def __init__(self, id: int, name: str, tier: str, attack: int, quest: Optional[str] = None) -> None: ...

TIERS: list[tuple[str, int]]
TYPES: list[str]
QUEST_GATE: dict[str, str]
MELEE_WEAPONS: list[MeleeWeapon]
PICKAXES: list[MeleeWeapon]

def banked_pickaxe(banked: Optional[Mapping[int, int]], attack: int) -> Optional[MeleeWeapon]: ...
def wieldable(attack: int, quest_done: Callable[[str], bool]) -> list[MeleeWeapon]: ...
def held_weapon(held: Optional[Mapping[int, int]], worn: Optional[set[int]], attack: int, quest_done: Callable[[str], bool]) -> Optional[MeleeWeapon]: ...
def banked_weapon(banked: Optional[Mapping[int, int]], attack: int, quest_done: Callable[[str], bool]) -> Optional[MeleeWeapon]: ...
def quest_done(quest: str) -> bool: ...
def best_held(snap: QuestSnapshot) -> Optional[MeleeWeapon]: ...
def wielded_weapon(snap: QuestSnapshot) -> Optional[MeleeWeapon]: ...
def pack_weapon(snap: QuestSnapshot) -> Optional[MeleeWeapon]: ...
def best_banked(snap: QuestSnapshot) -> Optional[MeleeWeapon]: ...
def live_best_weapon() -> Optional[MeleeWeapon]: ...
