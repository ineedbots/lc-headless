def anchor_for(site: DragonSite, style: str, index: int) -> Tile: ...
def chases_target(site: DragonSite, style: str) -> bool: ...

class Fight(Task):
    def __init__(self, host: Any, site: DragonSite) -> None: ...
    def blocks_loot(self) -> bool: ...
    def has_chase_target(self) -> bool: ...
    def reset(self) -> None: ...
    def interrupt_watch(self) -> None: ...
    def validate(self) -> bool: ...
    def execute(self) -> Wait[None]: ...

class Retreat(Task):
    def __init__(self, host: Any, site: DragonSite) -> None: ...

class HoldSafespot(Task):
    def __init__(self, host: Any, site: DragonSite) -> None: ...

