def guarded(drop: Any, bodies: Sequence[Any], radius: int = 4) -> bool: ...

# supply

class FlaskPlan:
    flask: str
    doses: list[str]
    want: int
    def __init__(self, flask: str, doses: list[str], want: int) -> None: ...

class BankOpts:
    withdraw_food: bool
    deposit_inventory: bool
    rune_casts: Optional[int]
    rune_buffer: Optional[int]
    ammo: Optional[int]
    escape_stock: Optional[int]
    heal_to: Optional[float]
    potions: Optional[list[PotionPlan]]
    flasks: Optional[list[FlaskPlan]]
    wear: Optional[list[str]]
    carry: Optional[list[str]]
    leave: Optional[Callable[[Any, DragonSite], Wait[bool]]]
    def __init__(self, withdraw_food: bool = False, deposit_inventory: bool = False, rune_casts: Optional[int] = None,
                 rune_buffer: Optional[int] = None, ammo: Optional[int] = None, escape_stock: Optional[int] = None,
                 heal_to: Optional[float] = None, potions: Optional[list[PotionPlan]] = None, flasks: Optional[list[FlaskPlan]] = None,
                 wear: Optional[list[str]] = None, carry: Optional[list[str]] = None,
                 leave: Optional[Callable[[Any, DragonSite], Wait[bool]]] = None) -> None: ...

class EscapeSpell:
    runes: list[tuple[str, int]]
    level: int
    label: str

SHIELD: str
