# rs2004.hunting: rs2b0t's boss and dragon framework. The pure decisions (logic), the dragon sites (sites), supplying
# a hunt (supply), the fight's tasks (combat) and loot under guard (guarded). See docs/scripting/hunting.md.

from typing import Any, Callable, Optional, Sequence, Union

from __builtins__ import Npc, SettingDef, SettingsBag, Task, Tile, Wait
from rs2004.catalogs import PotionPlan, Record

