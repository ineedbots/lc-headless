# sites

class DragonStand:
    label: str
    tiles: list[Tile]
    anchor: Tile
    def __init__(self, label: str, tiles: list[Tile], anchor: Tile) -> None: ...

class DragonSite:
    key: str
    label: str
    target: str
    bones: str
    key_item: Optional[Record]
    gate: Optional[Record]
    approach: list[Tile]
    safespots: list[Tile]
    melee_anchor: Tile
    bank: Tile
    escape_teleport_id: str
    walk_out: Tile
    ranged_threat: Optional[bool]
    loot_setting: Optional[str]
    food: Optional[str]
    antipoison: Optional[bool]
    talk_gate: Optional[Record]
    exit: Optional[Record]
    stands: Optional[list[DragonStand]]
    also_hunt: Optional[list[str]]
    fee_gate: Optional[Record]
    fire_at_range: Optional[bool]
    antifire: Optional[bool]
    coins: Optional[int]
    axe: Optional[bool]
    food_per_trip: Optional[int]
    def __init__(self, key: Optional[str] = None, label: Optional[str] = None, target: Optional[str] = None, bones: Optional[str] = None,
                 key_item: Optional[Record] = None, gate: Optional[Record] = None, approach: Optional[list[Tile]] = None,
                 safespots: Optional[list[Tile]] = None, melee_anchor: Optional[Tile] = None, bank: Optional[Tile] = None,
                 escape_teleport_id: Optional[str] = None, walk_out: Optional[Tile] = None, ranged_threat: Optional[bool] = None,
                 loot_setting: Optional[str] = None, food: Optional[str] = None, antipoison: Optional[bool] = None,
                 talk_gate: Optional[Record] = None, exit: Optional[Record] = None, stands: Optional[list[DragonStand]] = None,
                 also_hunt: Optional[list[str]] = None, fee_gate: Optional[Record] = None, fire_at_range: Optional[bool] = None,
                 antifire: Optional[bool] = None, coins: Optional[int] = None, axe: Optional[bool] = None,
                 food_per_trip: Optional[int] = None, in_area: Optional[Callable[[Optional[Tile]], bool]] = None) -> None: ...
    def in_area(self, tile: Optional[Any]) -> bool: ...
    def with_changes(self, **changes: Any) -> "DragonSite": ...

def in_box(min_x: int, max_x: int, min_z: int, max_z: int, level: int) -> Callable[[Optional[Any]], bool]: ...
TAVERLEY_BLUE: DragonSite
TAVERLEY_BLACK: DragonSite
HEROES_BLUE: DragonSite
GUTANOTH_BLUE: DragonSite
BRIMHAVEN_IRON: DragonSite
BRIMHAVEN_STEEL: DragonSite
