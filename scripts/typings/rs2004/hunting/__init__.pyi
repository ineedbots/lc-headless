def chase_mode(style: str, fire_at_range: bool) -> bool: ...
def prayer_for(style: str, fire_at_range: bool) -> Optional[str]: ...
def prayer_sip_due(points: int, max_points: int) -> bool: ...
def loot_reach(fire_at_range: bool) -> int: ...
def attack_range_for(style: str) -> int: ...
def engage_range_for(style: str) -> int: ...
def gap_to(from_: Any, tile: Any, size: int) -> int: ...
def shield_gate(style: str, fire_at_range: bool, has_shield: bool) -> Optional[str]: ...
