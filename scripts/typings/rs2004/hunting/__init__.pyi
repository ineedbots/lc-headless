ENCLAVE_TARGET_OPTIONS: list[str]
def needs_shield(site: DragonSite, style: str) -> bool: ...
def enclave_targets(site: DragonSite, mode: str = 'both') -> DragonSite: ...
def hunt_names(site: DragonSite) -> list[str]: ...
def stand_for(site: DragonSite, n: int) -> DragonStand: ...
def site_for(key: str) -> DragonSite: ...

