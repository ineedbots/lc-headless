class SolveClueHost:
    """A host built from functions; the ones left None are the ones the host doesn't have."""
    def __init__(self, log: Optional[Log] = None, set_status: Optional[Callable[[str], None]] = None,
                 is_food: Optional[Callable[[str], bool]] = None, food_name: Optional[Callable[[], str]] = None,
                 food_withdraw: Optional[Callable[[], int]] = None, weapon_name: Optional[Callable[[], str]] = None,
                 enabled: Optional[Callable[[], bool]] = None, hard_food_target: Optional[int] = None,
                 ranged_loadout: Optional[Callable[[], Optional[GuardianRangedLoadout]]] = None,
                 prepare_initial_bank: Optional[Callable[[], Wait[bool]]] = None, restore_prayer: Optional[Callable[[], bool]] = None,
                 use_teleports: Optional[Callable[[], bool]] = None) -> None: ...

class SolveClue(Task):
    """Solves the clues a bot picks up. host gives log(m), set_status(text), is_food(name), food_name() and
    food_withdraw(), and as it has them weapon_name(), enabled(), hard_food_target, ranged_loadout(),
    prepare_initial_bank(), restore_prayer() and use_teleports(). set_status('clue solved') ends a trail."""
    host: Any
    executor: ClueExecutor
    status: str
    def __init__(self, host: Any) -> None: ...
    def retry(self) -> None: ...
    def owns_equipment(self) -> bool: ...
    def clue_status(self) -> str: ...
    def note_death(self) -> None: ...
    def validate(self) -> bool: ...
    def execute(self) -> Wait[None]: ...
