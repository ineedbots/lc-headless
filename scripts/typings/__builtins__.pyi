# Declarations of what the client adds to every script's builtins, for editors only: Pylance and Pyright
# read this file, the client never does. See docs/ScriptingApi.md for what each function does.

from typing import Any, Optional, Sequence, Union

Ids = Union[int, Sequence[int], None]
Point = tuple[int, int]

settings: "Settings"

COMBAT_TICKS: int
INVENTORY: int
EQUIPMENT: int
BANK: int
BANK_INVENTORY: int
INVENTORY_SIZE: int
ATTACK: int
DEFENCE: int
STRENGTH: int
HITPOINTS: int
RANGED: int
PRAYER: int
MAGIC: int
COOKING: int
WOODCUTTING: int
FLETCHING: int
FISHING: int
FIREMAKING: int
CRAFTING: int
SMITHING: int
MINING: int
HERBLORE: int
AGILITY: int
THIEVING: int
RUNECRAFT: int
LAYER_WALL: int
LAYER_WALL_DECOR: int
LAYER_GROUND: int
LAYER_GROUND_DECOR: int

class _Entity:
    index: int
    x: int
    z: int
    level: int
    animation: int
    moving: bool
    hp: Optional[int]
    max_hp: Optional[int]
    last_hit_tick: Optional[int]
    target: Optional[tuple[str, int]]
    def is_moving(self) -> bool: ...
    def in_combat(self) -> bool: ...

class Npc(_Entity):
    id: int

class Player(_Entity):
    name: Optional[str]
    combat_level: int

class GroundItem:
    id: int
    count: int
    x: int
    z: int
    level: int

class Loc:
    id: int
    x: int
    z: int
    level: int
    shape: int
    angle: int
    layer: int

class Item:
    id: int
    count: int
    slot: int
    com: int

class Settings:
    def __getattr__(self, name: str) -> Any: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def __contains__(self, key: str) -> bool: ...

def log(*args: Any) -> None: ...
def debug(*args: Any) -> None: ...
def get_tick() -> int: ...
def stop_script() -> None: ...
def stop_account() -> None: ...
def send_bot_message(username: str, message: Any) -> bool: ...

def get_x() -> int: ...
def get_z() -> int: ...
def get_level() -> int: ...
def get_position() -> Point: ...
def get_pid() -> int: ...
def get_name() -> Optional[str]: ...
def get_combat_level() -> int: ...
def get_run_energy() -> int: ...
def get_weight() -> int: ...
def is_moving() -> bool: ...
def get_walk_destination() -> Optional[Point]: ...
def in_combat() -> bool: ...
def is_running() -> bool: ...
def get_local_player() -> Player: ...

def get_current_stat(stat: int) -> int: ...
def get_max_stat(stat: int) -> int: ...
def get_experience(stat: int) -> int: ...
def get_hp() -> int: ...
