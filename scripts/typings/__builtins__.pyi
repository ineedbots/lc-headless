def get_hp_percent() -> int: ...

def distance_to(x: int, z: int) -> int: ...
def distance(x1: int, z1: int, x2: int, z2: int) -> int: ...
def in_radius_of(x: int, z: int, radius: int) -> bool: ...
def in_rect(x: int, z: int, width: int, height: int) -> bool: ...
def at(x: int, z: int) -> bool: ...

def get_npcs(ids: Ids = None, radius: Optional[int] = None) -> list[Npc]: ...
def get_nearest_npc_by_id(ids: Ids = None, radius: Optional[int] = None, in_combat: Optional[bool] = None) -> Optional[Npc]: ...
