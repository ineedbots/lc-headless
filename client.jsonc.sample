// Sample config. Copy it to client.jsonc, set server.host and server.port and the login RSA key, and put the server's cache in client.cacheDirectory.
// Each account goes in its own file in scripting.accountsDirectory.
{
    "server": {
        // ws, wss or tcp. A local engine serves ws on port 80 on Windows, and on 8888 on Linux, and tcp on 43594.
        "transport": "ws",
        "host": "localhost",
        "port": 80,
        "origin": "http://localhost",
        "tlsCaFile": "SYSTEM"
    },
    // Optional SOCKS5 proxy for every account; an empty host connects directly.
    "proxy": {
        "host": "",
        "port": 1080,
        "username": "",
        "password": ""
    },
    "login": {
        "rsaModulus": "0x0",
        "rsaExponent": "0x0",
        "lowMemory": false,
        // 289, 274 or 225, the server's revision. client.cacheDirectory must hold the same revision's cache.
        "revision": 289
    },
    "client": {
        "logLevel": "info",
        "cacheDirectory": "data/cache",
        "navDirectory": "data/nav",
        // Where log lines are appended, as well as the console; "" for no file.
        "logFile": "rs2004-headless.log"
    },
    "scripting": {
        "accountsDirectory": "accounts",
        "scriptsDirectory": "scripts",
        "callTimeoutMs": 1000,
        "pollIntervalMs": 10,
        "loginIntervalSeconds": 2,
        "killGraceSeconds": 30,
        // 0 disables retries and reconnects; 100 retries indefinitely on temporary failures.
        "connectAttempts": 10,
        "reloginDelaySeconds": 60,
        "progressDirectory": "progress"
    }
}
