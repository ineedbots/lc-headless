// Sample config. Copy it to client.jsonc, set server.url and the login RSA key, and put the server's cache in client.cacheDirectory.
// Each account goes in its own file in scripting.accountsDirectory.
{
    "server": {
        "url": "ws://localhost:80",
        "origin": "http://localhost",
        "tlsCaFile": "SYSTEM"
    },
    "login": {
        "rsaModulus": "0x0",
        "rsaExponent": "0x0",
        "lowMemory": false,
        // 289, or 225 for a 225 server. client.cacheDirectory must hold the same revision's cache.
        "revision": 289
    },
    "client": {
        "logLevel": "info",
        "cacheDirectory": "data/cache",
        "navDirectory": "data/nav",
        // Where log lines are appended, as well as the console; "" for no file.
        "logFile": "rs2004-headless.log"
    },
    "scripting": {
        "accountsDirectory": "accounts",
        "scriptsDirectory": "scripts",
        "callTimeoutMs": 1000,
        "pollIntervalMs": 10,
        "loginIntervalSeconds": 2,
        "killGraceSeconds": 30,
        "connectAttempts": 10,
        "reloginDelaySeconds": 60,
        "progressDirectory": "progress"
    }
}
